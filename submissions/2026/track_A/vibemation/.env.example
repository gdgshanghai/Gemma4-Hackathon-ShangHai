# ── API Keys（逗号分隔，多 Key 自动轮转）─────────────
# 从 https://openrouter.ai/keys 获取
OPENROUTER_KEYS=sk-or-v1-your-key-1,sk-or-v1-your-key-2,sk-or-v1-your-key-3
# 从 https://build.nvidia.com/ 获取
NVIDIA_KEY=nvapi-your-key

# ── Provider 连通性检查间隔（分钟）实际为 N ~ N+1 随机─
PROVIDER_CHECK_INTERVAL=5

# ── 默认 n8n 实例（JSON 数组，健康检查通过后自动加到前端）─
N8N_DEFAULT_INSTANCES=[{"name":"My n8n","url":"https://n8n.onrender.com","key":""}]
