# ingest-gateway — Go 1.22+ multi-stage build
# mTLS gRPC termination point for edge→cloud FeatureBundle ingestion.
# Validates, authenticates, and writes bundles to feature-store.

# ---- build stage ----
FROM golang:1.22-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /ingest-gateway .

# ---- run stage ----
FROM alpine:3.20
RUN adduser -D -u 1000 cloud
USER cloud
COPY --from=build /ingest-gateway /usr/local/bin/ingest-gateway
ENTRYPOINT ["ingest-gateway"]
