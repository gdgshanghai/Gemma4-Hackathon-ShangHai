# intervention-planner — Go 1.22+ multi-stage build
# Composes, signs (Ed25519), and dispatches intervention commands to the edge.
# Final cloud-side step before the edge safety-guard verifies and actuates.

# ---- build stage ----
FROM golang:1.22-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /intervention-planner .

# ---- run stage ----
FROM alpine:3.20
RUN adduser -D -u 1000 cloud
USER cloud
COPY --from=build /intervention-planner /usr/local/bin/intervention-planner
ENTRYPOINT ["intervention-planner"]
