# preprocess-svc — Go 1.22+ multi-stage build
# Applies band-pass filtering, ICA artifact removal, and band-power computation.
# Must run offline; never depends on cloud for core signal processing.

# ---- build stage ----
FROM golang:1.22-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /preprocess-svc .

# ---- run stage ----
FROM alpine:3.20
RUN adduser -D -u 1000 edge
USER edge
COPY --from=build /preprocess-svc /usr/local/bin/preprocess-svc
ENTRYPOINT ["preprocess-svc"]
