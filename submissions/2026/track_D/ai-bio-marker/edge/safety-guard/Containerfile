# safety-guard — Go 1.22+ multi-stage build
# Enforces the local safety envelope on every cloud-originated intervention command.
# Rejects commands exceeding current-density, charge, or montage limits.
# Runs offline; never trusts a cloud command without local verification.

# ---- build stage ----
FROM golang:1.22-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /safety-guard .

# ---- run stage ----
FROM alpine:3.20
RUN adduser -D -u 1000 edge
USER edge
COPY --from=build /safety-guard /usr/local/bin/safety-guard
ENTRYPOINT ["safety-guard"]
