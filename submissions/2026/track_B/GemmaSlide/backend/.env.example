# App metadata
APP_NAME=GemmaSlide Backend
APP_VERSION=0.1.0

# API limits
MAX_UPLOAD_SIZE_MB=50
MAX_SLIDE_COUNT=500

# Temp storage
TEMP_ROOT=/tmp/gemmaslide

# CORS (comma-separated)
CORS_ALLOW_ORIGINS=*

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
JOB_STATE_TTL_SECONDS=86400

# SSE
SSE_POLL_INTERVAL_SECONDS=1.0
SSE_HEARTBEAT_SECONDS=10.0

# LLM (OpenAI-compatible)
# Required for OpenAI endpoints.
OPENAI_API_KEY=your-api-key

# Optional: override model and endpoint (for OpenAI-compatible gateways/proxies)
LLM_MODEL=gpt-4o-mini
LLM_ENDPOINT=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000
LLM_SLIDE_CONTEXT_CHARS=800

# Branch tree generation LLM (multimodal, needs large output for 30-node JSON tree)
# Defaults to main LLM unless overridden here.
# Model must support image input (multimodal).
# BRANCH_LLM_MODEL=gemma-4-31b-it
# BRANCH_LLM_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/
# BRANCH_LLM_API_KEY=your-api-key
BRANCH_LLM_MAX_TOKENS=8192
BRANCH_LLM_REQUEST_TIMEOUT=90.0

# Sanitization tuning
DECORATIVE_MIN_AREA_NORM=0.002

# TTS (Text-to-Speech via Aliyun DashScope / Qwen TTS)
# Get your API key from: https://bailian.console.aliyun.com/?tab=model#/api-key
# If DASHSCOPE_API_KEY is not set, falls back to OPENAI_API_KEY.
DASHSCOPE_API_KEY=your-dashscope-api-key
TTS_ENABLED=true
TTS_MODEL=qwen3-tts-flash
TTS_VOICE=Cherry
TTS_MAX_RETRIES=5

# ASR (Automatic Speech Recognition via Aliyun DashScope)
# Uses the same DASHSCOPE_API_KEY above.
ASR_MODEL=fun-asr-realtime
ASR_SAMPLE_RATE=16000
ASR_FORMAT=pcm
ASR_SEMANTIC_PUNCTUATION_ENABLED=true
